rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════
    //  RUMMIKUBE — חוקי אבטחה
    //
    //  שלב 1 (הקובץ הזה): נועל הסלמת-הרשאות וזהות. שחקן כבר לא יכול:
    //   • להפוך את עצמו לאדמין / GOD / בעל-קלאב / מאושר (role/status)
    //   • לשייך את עצמו לסוכן או לשנות עמלות (agentUid/agentPct/...)
    //   • לזייף מייל כדי לקבל GOD (המייל נקרא מה-token של גוגל, לא ממסמך)
    //   • למחוק/לשנות קלאב שהוא לא הבעלים שלו, או לשדר הודעות מועדון
    //   • לשנות email/role/isBot במסמך users שלו
    //
    //  שלב 2 (עם ה-Cloud Functions): נעילת balance/clubProfits/agentProfits
    //  ו-stack בשולחן, כך שכל תנועת כסף תעבור אך ורק דרך השרת. עד אז שדות
    //  הכסף עדיין ניתנים לכתיבה מהלקוח (המשחק הקיים ממשיך לעבוד).
    // ═══════════════════════════════════════════════════════════════════

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // GOD נקבע לפי המייל ב-token של גוגל, לעולם לא לפי שדה שהמשתמש כותב
    function isGod() {
      return signedIn()
        && request.auth.token.email in ['aaci.yoni@gmail.com', 'info.bagso@gmail.com'];
    }

    function memPath(clubId) {
      return /databases/$(database)/documents/memberships/$(uid() + '_' + clubId);
    }
    function myRole(clubId) {
      return exists(memPath(clubId)) ? get(memPath(clubId)).data.role : 'none';
    }
    // צוות ניהול של קלאב מסוים (או GOD גלובלי)
    function isStaffOf(clubId) {
      return isGod() || myRole(clubId) in ['super_admin', 'club_owner', 'manager'];
    }
    // שדה שלא השתנה בעדכון (עמיד לשדות חסרים בשני הצדדים)
    function same(field) {
      return resource.data.get(field, null) == request.resource.data.get(field, null);
    }

    // ─────────── users ───────────
    match /users/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        isGod()
        || ( id == uid()
             && request.resource.data.role == 'player'
             && request.resource.data.isBot == false
             && request.resource.data.balance == 0 )
      );
      // אסור לשנות email/role/isBot/balance מהלקוח; שאר השדות (שם, אווטאר, סטטיסטיקה) מותרים.
      // balance נעול כדי שלא יומצא כסף במסמך users (הכסף האמיתי ב-memberships, אבל כלים
      // מסוימים סוכמים גם את users.balance — אז נועלים כדי שלא יזרום פנימה סכום מזויף).
      allow update: if signedIn() && (
        isGod()
        || ( id == uid() && same('email') && same('role') && same('isBot') && same('balance') )
      );
      allow delete: if isGod();
    }

    // ─────────── memberships ───────────
    match /memberships/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        isGod()
        // הצטרפות רגילה: חברות של עצמי, תמיד player/pending/0
        || ( id == uid() + '_' + request.resource.data.clubId
             && request.resource.data.uid == uid()
             && request.resource.data.role == 'player'
             && request.resource.data.status == 'pending'
             && request.resource.data.balance == 0 )
        // הקמת קלאב: הבעלים יוצר לעצמו חברות ניהול - רק אם הוא באמת ownerUid בקלאב
        || ( id == uid() + '_' + request.resource.data.clubId
             && request.resource.data.role == 'club_owner'
             && exists(/databases/$(database)/documents/clubs/$(request.resource.data.clubId))
             && get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.ownerUid == uid() )
      );
      // צוות/GOD משנה הכול (קופה, ניהול). שחקן רגיל: אסור לגעת בתפקיד/סטטוס/סוכן,
      // אסור להגדיל את היתרה של עצמו (מניעת המצאת כסף), ואסור לגעת ביתרת אחר
      // (מניעת גניבה). כל תנועת כסף אמיתית עוברת דרך Cloud Functions (עוקפות חוקים).
      allow update: if signedIn() && (
        isGod()
        // צוות (super_admin/club_owner/manager) מנהל חברויות של *אחרים* בלבד. עריכה-עצמית
        // עוברת דרך הענף הנעול למטה — כדי שמנהל לא יקדם את עצמו ל-super_admin/בעלים
        // ולא ימציא לעצמו יתרה (הסלמת-הרשאות + המצאת-כסף). כסף אמיתי עובר רק דרך Cloud Functions.
        || ( isStaffOf(resource.data.clubId) && id != uid() + '_' + resource.data.clubId )
        || ( same('role') && same('status') && same('uid') && same('clubId')
             && same('agentUid') && same('agentPct') && same('agentSharePct')
             && same('agentCode') && same('clubProfits') && same('agentProfits')
             // מונע איפוס-עצמי של קֶצֶב-הבונוס (ניצול לריקון קופת-הבעלים)
             && same('lastBonusAt') && same('lastScratchAt') && same('bonusPaid')
             && ( same('balance')
                  || ( id == uid() + '_' + resource.data.clubId
                       && request.resource.data.get('balance', 0) <= resource.data.get('balance', 0) ) ) )
        // הגשה-מחדש אחרי דחייה: בעל החברות בלבד, רק rejected -> pending, בלי לגעת בשאר
        || ( id == uid() + '_' + resource.data.clubId
             && resource.data.status == 'rejected'
             && request.resource.data.status == 'pending'
             && same('role') && same('balance') && same('clubProfits')
             && same('agentProfits') && same('agentUid') && same('agentPct') )
      );
      allow delete: if isStaffOf(resource.data.clubId);
    }

    // ─────────── clubs ───────────
    match /clubs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == uid();
      allow update: if isGod() || resource.data.ownerUid == uid() || isStaffOf(id);
      allow delete: if isGod() || resource.data.ownerUid == uid();
    }

    // ─────────── broadcasts (הודעות מועדון) ───────────
    match /broadcasts/{clubId} {
      allow read: if signedIn();
      allow write: if isStaffOf(clubId);
    }

    // ─────────── tables (משחק חי) ───────────
    // המשחק (קלפים/לוח/תור) נכתב מהלקוח, אבל bank (הסטאקים = כסף) נעול:
    // אותו כותבות רק Cloud Functions (עוקפות חוקים) או GOD (מוח-הבוטים).
    match /tables/{id} {
      allow read: if signedIn();
      // יצירה: מותר לכל מחובר לפתוח שולחן, אבל ה-bank (=כסף) חייב להיות ריק. אחרת
      // שחקן היה יכול ליצור שולחן-דמה עם bank מזויף ואז "לפדות" אותו ליתרה אמיתית
      // (המצאת כסף). שולחנות תקינים תמיד נוצרים עם bank ריק; כסף נכנס רק דרך השרת.
      allow create: if signedIn() && (
        isGod() || request.resource.data.get('bank', {}).size() == 0
      );
      // ברירת-מחדל: הלקוח כותב הכל חוץ מ-bank (כסף). על שולחן srvAuth (מנוע-שרת מלא)
      // גם הקלפים/הקופה/התור נעולים לשרת בלבד — הלקוח כותב רק דרך Cloud Functions
      // (ramiDrawSrv/…); נשאר לו chat ו-freshReq (אישורי-פריש) בלבד. כך הקלפים לא ניתנים
      // לכתיבה מהלקוח (מונע גם זיוף-יד וגם קריאת/שינוי ידי-אחרים).
      allow update: if isGod()
        || ( signedIn()
             && !('bank' in request.resource.data.diff(resource.data).affectedKeys())
             && ( resource.data.get('srvAuth', false) != true
                  || !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['players','deck','discard','currentTurn','turnPhase','drawnThisTurn','phase','winner','settlePending','freshMult','srvAuth']) ) );
      // מחיקה: צוות/GOD (ניקוי שולחנות, ניהול טורנירים) או שולחן ללא כסף. כך אי-אפשר
      // למחוק שולחן חי שיש בו סטאקים (=השמדת צ'יפים של שחקנים) מבלי להיות צוות.
      allow delete: if isGod()
        || isStaffOf(resource.data.clubId)
        || resource.data.get('bank', {}).size() == 0;
    }
    // קלפים פרטיים למנוע-שרת עתידי: כל שחקן קורא רק את שלו, כותב רק השרת
    match /tables/{id}/priv/{u} {
      allow read: if signedIn() && uid() == u;
      allow write: if false;
    }

    // ─────────── tournaments ───────────
    match /tournaments/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ─────────── logs: append-only (מחיקה רק ל-GOD, לצורך איפוס מלא) ───────────
    match /gameLog/{id}  { allow read, create: if signedIn(); allow update: if false; allow delete: if isGod(); }
    match /agentLog/{id} { allow read, create: if signedIn(); allow update: if false; allow delete: if isGod(); }

    // ─────────── securityAlerts (התראות הונאה) — GOD בלבד ───────────
    match /securityAlerts/{id} { allow read, create, delete: if isGod(); allow update: if false; }

    // ─────────── חסימות-טלפון: נכתב רק דרך Cloud Function (admin עוקף חוקים) ───────────
    match /clubBans/{id} { allow read: if signedIn(); allow write: if false; }

    // ─────────── קודי-כניסה (PIN) וקודי-SMS: שרת בלבד, לעולם לא מהלקוח ───────────
    match /pins/{id} { allow read, write: if false; }
    match /otp/{id}  { allow read, write: if false; }

    // ─────────── admin config: אין גישת לקוח ───────────
    match /admin/{doc=**} { allow read, write: if false; }

    // כל השאר חסום
    match /{document=**} { allow read, write: if false; }
  }
}
